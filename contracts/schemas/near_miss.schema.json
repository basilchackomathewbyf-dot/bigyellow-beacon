{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigyellowfish.ai/beacon/near_miss.schema.json",
  "title": "NearMissRecord",
  "description": "One near-miss / hazard report, produced on-device by Gemma from voice, photo or text. Synced ashore as-is (contains no wellbeing data).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id", "schema_version", "vessel_id", "reporter_ref", "created_at",
    "source", "original_language", "original_text", "english_text",
    "location", "hazard_type", "ism_report_type", "severity",
    "description", "needs_clarification", "extraction"
  ],
  "properties": {
    "record_id": { "type": "string", "format": "uuid" },
    "schema_version": { "const": "1.0" },
    "vessel_id": { "type": "string", "pattern": "^VSL-[A-Z0-9]{3,12}$" },
    "reporter_ref": {
      "type": "string",
      "description": "Pseudonymous, rotating reporter token. Never a name or crew ID.",
      "pattern": "^anon-[a-f0-9]{8,32}$"
    },
    "reporter_rank_group": {
      "type": "string",
      "enum": ["deck_officer", "engine_officer", "deck_rating", "engine_rating", "catering", "cadet", "undisclosed"],
      "default": "undisclosed"
    },
    "created_at": { "type": "string", "format": "date-time" },
    "occurred_at": { "type": ["string", "null"], "format": "date-time" },
    "source": { "type": "string", "enum": ["voice", "photo", "text", "voice+photo"] },
    "original_language": {
      "type": "string",
      "description": "BCP-47 tag, e.g. hi, tl, uk, zh, id, en",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "original_text": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "english_text": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "photo_refs": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 4,
      "description": "Local blob keys; photos sync only on good links."
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["area"],
      "properties": {
        "area": {
          "type": "string",
          "enum": [
            "main_deck", "forecastle", "poop_deck", "mooring_station", "cargo_hold", "cargo_tank_area",
            "crane_area", "accommodation_ladder", "pilot_ladder", "internal_stairway", "engine_room",
            "steering_gear_room", "pump_room", "enclosed_space", "galley", "accommodation", "bridge",
            "lifeboat_station", "gangway", "other", "unknown"
          ]
        },
        "detail": { "type": ["string", "null"], "maxLength": 200, "description": "Free text, e.g. 'near crane no. 2, port side'" }
      }
    },
    "hazard_type": {
      "type": "string",
      "description": "TODO: replace with the 6-7 cause categories from the internal accident-investigation corpus so on-board extraction and ashore matching share one taxonomy.",
      "enum": [
        "slip_trip_fall",
        "ladder_access",
        "lifting_crane_ops",
        "mooring_ops",
        "machinery_hydraulic",
        "enclosed_space_atmosphere",
        "fire_electrical",
        "cargo_chemical_handling",
        "other"
      ]
    },
    "ism_report_type": {
      "type": "string",
      "description": "ISM Code s.9 reporting class.",
      "enum": ["near_miss", "hazardous_situation", "non_conformity", "accident"]
    },
    "severity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "potential_consequence"],
      "properties": {
        "level": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "potential_consequence": {
          "type": "string",
          "enum": ["none", "first_aid", "lost_time_injury", "serious_injury", "fatality", "pollution", "equipment_damage"]
        }
      }
    },
    "recurring": { "type": "boolean", "default": false, "description": "Reporter says it happened before ('again')." },
    "description": { "type": "string", "maxLength": 500, "description": "One-sentence English summary." },
    "needs_clarification": { "type": "boolean" },
    "clarifying_question": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["field", "question_en", "question_local"],
      "properties": {
        "field": { "type": "string", "enum": ["location", "hazard_type", "severity", "occurred_at"] },
        "question_en": { "type": "string", "maxLength": 200 },
        "question_local": { "type": "string", "maxLength": 300 }
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "confidence", "status"],
      "properties": {
        "model": { "type": "string", "description": "e.g. gemma-3n-e2b-it@litert" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "status": {
          "type": "string",
          "enum": ["structured", "needs_shore_structuring"],
          "description": "needs_shore_structuring = on-device JSON failed validation twice; Gemini re-extracts ashore."
        },
        "attempts": { "type": "integer", "minimum": 1, "maximum": 3 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "needs_clarification": { "const": true } } },
      "then": { "required": ["clarifying_question"], "properties": { "clarifying_question": { "type": "object" } } }
    }
  ]
}
