{
  "$defs": {
    "RejectReason": {
      "enum": [
        "DUPLICATE",
        "NOT_A_NEAR_MISS",
        "INSUFFICIENT_INFO",
        "OUT_OF_SCOPE"
      ],
      "title": "RejectReason",
      "type": "string"
    },
    "ShoreStatus": {
      "description": "Owned by shore-api. QUEUED_FOR_LINK is the only value the edge sets (before first push).",
      "enum": [
        "QUEUED_FOR_LINK",
        "NEW",
        "IN_REVIEW",
        "REJECTED",
        "CLOSED"
      ],
      "title": "ShoreStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "ticket_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Ticket Id",
      "type": "string"
    },
    "shore_status": {
      "$ref": "#/$defs/ShoreStatus"
    },
    "reject_reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/RejectReason"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reject_note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reject Note"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "ticket_id",
    "shore_status",
    "updated_at"
  ],
  "title": "TicketShoreStatusChange",
  "type": "object"
}