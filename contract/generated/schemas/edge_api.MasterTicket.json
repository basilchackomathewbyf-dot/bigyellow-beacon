{
  "$defs": {
    "ActionType": {
      "enum": [
        "ack",
        "action",
        "resolve",
        "note"
      ],
      "title": "ActionType",
      "type": "string"
    },
    "ActorRole": {
      "enum": [
        "master",
        "shore",
        "system"
      ],
      "title": "ActorRole",
      "type": "string"
    },
    "HazardType": {
      "enum": [
        "slip_trip_fall",
        "fall_from_height",
        "ladder_access",
        "lifting_crane_ops",
        "mooring_ops",
        "machinery_hydraulic",
        "enclosed_space",
        "fire_electrical",
        "cargo_chemical",
        "struck_by_object",
        "navigation",
        "other"
      ],
      "title": "HazardType",
      "type": "string"
    },
    "IsmCategory": {
      "description": "Proposed list (pending Kundan / Captain review). Doc example uses unsafe_condition.",
      "enum": [
        "unsafe_act",
        "unsafe_condition",
        "equipment_failure",
        "procedure_not_followed",
        "environmental",
        "other"
      ],
      "title": "IsmCategory",
      "type": "string"
    },
    "MediaKind": {
      "enum": [
        "photo",
        "audio"
      ],
      "title": "MediaKind",
      "type": "string"
    },
    "MediaRef": {
      "additionalProperties": false,
      "properties": {
        "media_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Media Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/MediaKind"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "media_id",
        "kind"
      ],
      "title": "MediaRef",
      "type": "object"
    },
    "OnboardStatus": {
      "description": "Owned by the edge (Master).",
      "enum": [
        "NEW",
        "ACKNOWLEDGED",
        "ACTION_IN_PROGRESS",
        "RESOLVED_ON_BOARD"
      ],
      "title": "OnboardStatus",
      "type": "string"
    },
    "RankBand": {
      "enum": [
        "officer",
        "rating",
        "cadet",
        "crew"
      ],
      "title": "RankBand",
      "type": "string"
    },
    "Severity": {
      "enum": [
        1,
        2,
        3,
        4,
        5
      ],
      "title": "Severity",
      "type": "integer"
    },
    "ShoreStatus": {
      "description": "Owned by shore-api. QUEUED_FOR_LINK is the only value the edge sets (before first push).",
      "enum": [
        "QUEUED_FOR_LINK",
        "NEW",
        "IN_REVIEW",
        "REJECTED",
        "CLOSED"
      ],
      "title": "ShoreStatus",
      "type": "string"
    },
    "TicketActionView": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Action Id",
          "type": "string"
        },
        "ticket_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Ticket Id",
          "type": "string"
        },
        "actor_role": {
          "$ref": "#/$defs/ActorRole"
        },
        "action_type": {
          "$ref": "#/$defs/ActionType"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "responsible_rank": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Responsible Rank"
        },
        "due_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Due At"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "ticket_id",
        "actor_role",
        "action_type",
        "created_at"
      ],
      "title": "TicketActionView",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "GET /master/tickets item. reporter_name is set only when the reporter opted in.",
  "properties": {
    "ticket_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Ticket Id",
      "type": "string"
    },
    "ticket_no": {
      "title": "Ticket No",
      "type": "string"
    },
    "title_en": {
      "title": "Title En",
      "type": "string"
    },
    "description_en": {
      "title": "Description En",
      "type": "string"
    },
    "description_original": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description Original"
    },
    "original_language": {
      "title": "Original Language",
      "type": "string"
    },
    "location_on_board": {
      "title": "Location On Board",
      "type": "string"
    },
    "hazard_type": {
      "$ref": "#/$defs/HazardType"
    },
    "ism_category": {
      "$ref": "#/$defs/IsmCategory"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "immediate_action": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Immediate Action"
    },
    "occurred_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Occurred At"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "onboard_status": {
      "$ref": "#/$defs/OnboardStatus"
    },
    "shore_status": {
      "$ref": "#/$defs/ShoreStatus"
    },
    "rank_band": {
      "$ref": "#/$defs/RankBand"
    },
    "reporter_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reporter Name"
    },
    "media": {
      "default": [],
      "items": {
        "$ref": "#/$defs/MediaRef"
      },
      "title": "Media",
      "type": "array"
    },
    "actions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TicketActionView"
      },
      "title": "Actions",
      "type": "array"
    }
  },
  "required": [
    "ticket_id",
    "ticket_no",
    "title_en",
    "description_en",
    "original_language",
    "location_on_board",
    "hazard_type",
    "ism_category",
    "severity",
    "created_at",
    "onboard_status",
    "shore_status",
    "rank_band"
  ],
  "title": "MasterTicket",
  "type": "object"
}