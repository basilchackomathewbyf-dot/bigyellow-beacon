    },
    "description_en": {
      "anyOf": [
        {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description En"
    },
    "location_on_board": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Location On Board"
    },
    "hazard_type": {
      "anyOf": [
        {
          "$ref": "#/$defs/HazardType"
        },
        {
          "type": "null"
        }
