```
GCP_PROJECT=byf-beacon-2026
FIRESTORE_DB=(default)
GEMINI_MODEL=gemini-2.5-flash        # check the current model list in Vertex AI Model Garden and use the newest GA Flash; keep configurable
GEMINI_PRO_MODEL=gemini-2.5-pro      # monthly report only
VERTEX_LOCATION=us-central1
EMBED_MODEL=gemini-embedding-001
MEDIA_BUCKET=byf-beacon-2026-media
CORS_ORIGINS=https://byf-beacon-2026.web.app,http://localhost:5174
K_ANON=5
CLUSTER_WINDOW_DAYS=30
CLUSTER_MIN_REPORTS=3
CLUSTER_MIN_VESSELS=2
CLUSTER_MAX_DISTANCE=0.25            # cosine distance; tune with the seed data
